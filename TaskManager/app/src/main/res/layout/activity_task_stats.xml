<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estadísticas de tareas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvTotalTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total de tareas: 0"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPendingTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pendientes: 0"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvInProgressTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En progreso: 0"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvCompletedTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completadas: 0"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvCancelledTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canceladas: 0"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvCompletionPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Porcentaje completado: 0%"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressCompletion"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
