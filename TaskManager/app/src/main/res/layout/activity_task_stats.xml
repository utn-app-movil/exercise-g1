<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Total de tareas -->
        <TextView
            android:id="@+id/tvTotal_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_total_default"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Tareas pendientes -->
        <TextView
            android:id="@+id/tvPending_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_pending_default"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Tareas en progreso -->
        <TextView
            android:id="@+id/tvInProgress_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_in_progress_default"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Tareas completadas -->
        <TextView
            android:id="@+id/tvCompleted_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_completed_default"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Tareas canceladas -->
        <TextView
            android:id="@+id/tvCancelled_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_cancelled_default"
            android:textSize="18sp"
            android:layout_marginBottom="28dp" />

        <!-- Porcentaje de tareas completadas -->
        <TextView
            android:id="@+id/tvProgress_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_progress_default"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Barra de progreso horizontal -->
        <ProgressBar
            android:id="@+id/pbCompleted_Stats"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="32dp" />

        <!-- Regresar al menú -->
        <Button
            android:id="@+id/btnBackMain_Stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_back_main" />

    </LinearLayout>

</ScrollView>