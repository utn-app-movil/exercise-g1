<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TaskStatsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">


        <TextView
            android:id="@+id/tvTotalTareas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextTotalTasks"
            android:textSize="24sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvPendientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/TextPending"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvEnProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextInProgress"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCompletadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextCompleted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCanceladas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextCancelled"
            android:textSize="18sp" />


        <ProgressBar
            android:id="@+id/progressBarCompletadas"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0" />


        <Button
            android:id="@+id/btnVolver_TaskStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/btnTextBack_main" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
